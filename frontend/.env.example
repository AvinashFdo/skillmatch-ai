# Vite loads .env.development automatically for `npm run dev`, and
# .env.production automatically for `npm run build` - no flags needed,
# this is Vite's built-in mode-based env file convention. Copy this file
# to whichever of those two you're setting up (or to plain .env.local
# for a personal override that Vite loads in every mode).
#
# Not a secret - this is just the API base URL the frontend calls, so
# .env.development and .env.production are committed to the repo
# (unlike backend/.env, which holds real secrets and is gitignored).
VITE_API_BASE_URL=http://localhost:5000/api
