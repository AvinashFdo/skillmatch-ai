# Copy this file to .env and fill in real values. .env is gitignored.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillmatch

# Secret used to sign JWTs - use a long random string in practice
JWT_SECRET=change_this_to_a_long_random_string

# How long issued JWTs stay valid
JWT_EXPIRES_IN=1d

# Base URL of the Python FastAPI AI service
AI_SERVICE_URL=http://localhost:8000

# Port this Express server listens on
PORT=5000

# Comma-separated list of allowed frontend origins for CORS.
# Set to * only during a short remote user-testing session via tunnels
# (the frontend's tunnel URL is unpredictable ahead of time) - switch
# back to the explicit localhost list afterward.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
